<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <GlobalPackageReference Include="CSharpier.MSBuild" Version="1.3.0" />
    <GlobalPackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <GlobalPackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.400" />
    <GlobalPackageReference Include="Meziantou.Analyzer" Version="3.0.163" />
    <GlobalPackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.400" />
    <GlobalPackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.7.23" />
    <GlobalPackageReference Include="NetEvolve.Defaults" Version="2.6.95" />
    <GlobalPackageReference Include="Roslynator.Analyzers" Version="4.16.1" />
    <GlobalPackageReference Include="Roslynator.Formatting.Analyzers" Version="4.16.1" />
    <GlobalPackageReference Include="Roslynator.CodeAnalysis.Analyzers" Version="4.16.1" />
    <GlobalPackageReference Include="Roslynator.CodeFixes" Version="4.16.1" />
    <GlobalPackageReference Include="Roslynator.Refactorings" Version="4.16.1" />
    <GlobalPackageReference Include="SonarAnalyzer.CSharp" Version="10.32.0.713" />
  </ItemGroup>
  <ItemGroup Label="Roslyn">
    <!--
      src/NetEvolve.FrameShift builds three variants of the analyzer assembly, one per supported Roslyn
      API surface (4.8.0 / 4.14.0 / 5.6.0 - see NetEvolve.FrameShift.Roslyn4_8/4_14/5_6.csproj and their
      shared NetEvolve.FrameShift.Build.props), so a consumer's SDK/VS can load whichever one its own
      Roslyn version actually supports instead of requiring the newest one. 4.8.0 is the floor:
      `CollectionExpressionSyntax` and its siblings, used by the collection-expression mutation and
      recognition code, first appear at 4.7.0, but that version still gates C# 12 collection expressions
      behind the 'preview' language version regardless of the requested LangVersion (CS8652). 4.8.0 (VS
      2022 17.8 / .NET SDK 8.0.100 GA) is the first tier where the feature is non-preview. 4.4.0 is
      excluded outright: the types above do not exist in its API surface at all.

      The PackageVersion entries below are the *ceiling* (newest variant), used as the central version by
      every project that does not need to build against more than one Roslyn API surface -
      NetEvolve.FrameShift.Execution and the test projects included. Each variant project of
      src/NetEvolve.FrameShift overrides this central version down to its own tier via
      VersionOverride="$(RoslynApiVersion)" on its Microsoft.CodeAnalysis.Analyzers/.CSharp
      PackageReference - legal without extra setup because CentralPackageVersionOverrideEnabled is not
      disabled anywhere in this repository.
    -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.6.0" />
    <!--
      Each Roslyn tier's own Microsoft.CodeAnalysis.Common brings a different minimum
      System.Collections.Immutable (4.8.0 -> 7.0.0, 4.14.0 -> 9.0.0, 5.6.0 -> 10.0.1). The Roslyn4_8
      variant's 7.0.0 predates the [CollectionBuilder] attribute on ImmutableArray<T> (added in 8.0.0),
      so `[...]` collection expressions targeting ImmutableArray<T> fail with CS9210 there. Central
      pinning must sit at or above the *highest* tier's own minimum (10.0.1) - pinning any lower trips
      NU1109 ("package downgrade detected") for the 4.14.0/5.6.0 variants, since
      CentralPackageTransitivePinningEnabled promotes this central version everywhere, including
      projects that never reference the package directly.
    -->
    <PackageVersion Include="System.Collections.Immutable" Version="10.0.1" />
  </ItemGroup>
  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.10.0" />
    <PackageVersion Include="NetEvolve.Extensions.TUnit" Version="3.5.348" />
    <!--
      .NET Framework never shipped Span{T}/ReadOnlySpan{T}; this package is what gives the classic
      target frameworks the real types, so a fixture using them binds and resolves the same way it does
      on .NET instead of leaving the test compilation with an unresolved type.
    -->
    <PackageVersion Include="System.Memory" Version="4.6.3" />
    <!--
      .NET Framework never shipped ValueTask/ValueTask{T}; this package is what gives the classic
      target frameworks the real types, so a fixture using them binds and resolves the same way it
      does on .NET instead of leaving the test compilation with an unresolved type.
    -->
    <PackageVersion Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
    <!--
      Supplies the compiler-required attributes that older frameworks do not ship, most notably
      `ModuleInitializerAttribute`, which TUnit's source generator emits into every test assembly, and
      a public `NotNullWhenAttribute`, which .NET Framework keeps internal.
    -->
    <PackageVersion Include="Polyfill" Version="11.2.0" />
    <PackageVersion Include="TUnit" Version="1.65.0" />
    <PackageVersion Include="Verify.TUnit" Version="31.28.0" />
  </ItemGroup>
  <ItemGroup Label="Test framework metadata">
    <!--
      These packages are consumed as compile-time metadata only, so that the framework adapters can be
      tested against the real attribute types instead of hand-written look-alikes. Their MSBuild assets
      must never be imported, because the test projects run on TUnit through Microsoft.Testing.Platform
      and a competing test-platform extension would break the run.
    -->
    <PackageVersion Include="MSTest.TestFramework" Version="4.3.3" />
    <PackageVersion Include="NUnit" Version="4.6.1" />
    <PackageVersion Include="xunit.core" Version="2.9.3" />
    <PackageVersion Include="xunit.v3.core" Version="3.2.2" />
  </ItemGroup>
</Project>
