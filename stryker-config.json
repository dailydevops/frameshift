{
  "stryker-config": {
    "solution": "FrameShift.slnx",
    "mutation-level": "Advanced",
    "reporters": ["html", "json", "dashboard", "progress"],
    "project-info": { "name": "github.com/dailydevops/frameshift" },
    "thresholds": { "high": 80, "low": 60, "break": 0 },
    "test-projects": [
      "tests/NetEvolve.FrameShift.Execution.Tests.Integration/NetEvolve.FrameShift.Execution.Tests.Integration.csproj",
      "tests/NetEvolve.FrameShift.Execution.Tests.Unit/NetEvolve.FrameShift.Execution.Tests.Unit.csproj",
      "tests/NetEvolve.FrameShift.Tests.Integration/NetEvolve.FrameShift.Tests.Integration.csproj",
      "tests/NetEvolve.FrameShift.Tests.Unit/NetEvolve.FrameShift.Tests.Unit.csproj"
    ],
    "coverage-analysis": "all",
    "mutate": ["**/*.cs", "!**/*.Designer.cs", "!**/*.g.cs", "!**/*.g.i.cs"],
    "test-runner": "mtp"
  }
}
