<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Matches the net10.0-only NetEvolve.FrameShift.Execution project this exercises. -->
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>

    <!-- Verify v33+ build-time license gate (SC021). FrameShift is a non-revenue open source project, so the OpenSource exemption applies.
         See https://github.com/VerifyTests/Verify/blob/main/docs/maintenance-fee.md
         Renew yearly: the end month may be at most 12 months ahead of the build date; builds fail after 2027-09. -->
    <Verify_SponsorshipExemption>OpenSource</Verify_SponsorshipExemption>
    <Verify_SponsorshipExemptionUntil>2027-09</Verify_SponsorshipExemptionUntil>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="NetEvolve.Extensions.TUnit" />
    <PackageReference Include="TUnit" />
    <PackageReference Include="Verify.TUnit" />
  </ItemGroup>
  <ItemGroup>
    <!-- net10.0-only, tracks the newest Roslyn variant (see NetEvolve.FrameShift.Execution.csproj). -->
    <ProjectReference Include="../../src/NetEvolve.FrameShift/NetEvolve.FrameShift.Roslyn5_6.csproj" />
    <ProjectReference Include="../../src/NetEvolve.FrameShift.Execution/NetEvolve.FrameShift.Execution.csproj" />
  </ItemGroup>
  <ItemGroup Label="Test categorisation">
    <AssemblyAttribute Include="NetEvolve.Extensions.TUnit.UnitTestAttribute" />
  </ItemGroup>
</Project>
