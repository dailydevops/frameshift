<Project>
  <!--
    NetEvolve.FrameShift - build assets.

    This file does three things:

      1. It tells the user when the analysis cannot do anything because no test-surface manifest reached
         the compiler (FSH0005).
      2. It has the manifest written directly into the directory of the production project a test
         project's ProjectReference exercises, instead of next to the test project - for every
         reference by default; opt a specific one out with the metadata 'DisableFrameShift="true"'.
      3. It turns the manifest the TestSurfaceManifestGenerator emits into the checked-in
         '<ProjectName>.<TargetFramework>.frameshift' file next to the test project, or into the
         referenced production project's directory when metadata 2 applies.

    Set 'FrameShiftSuppressSetupWarning' to 'true' to silence FSH0005, for example for projects that are
    deliberately not covered, or while the manifest of the first pass does not exist yet:

      <PropertyGroup>
        <FrameShiftSuppressSetupWarning>true</FrameShiftSuppressSetupWarning>
      </PropertyGroup>

    Set 'FrameShiftWriteTestSurfaceManifest' to 'false' to keep the analysis but never write a manifest,
    or to 'true' to force writing one for a project that references no known test framework package.
  -->

  <Target
    Name="FrameShiftWarnOnMissingTestSurfaceManifest"
    BeforeTargets="CoreCompile"
    Condition=" '$(FrameShiftEnabled)' == 'true'
                      AND '$(FrameShiftSuppressSetupWarning)' != 'true'
                      AND '$(DesignTimeBuild)' != 'true'
                      AND '$(IsTestProject)' != 'true'
                      AND '$(IsTestingPlatformApplication)' != 'true'
                      AND '$(FrameShiftIsTestProject)' != 'true' "
  >
    <ItemGroup>
      <_FrameShiftTestSurfaceManifest Include="@(AdditionalFiles)" Condition=" '%(Extension)' == '.frameshift' " />
    </ItemGroup>

    <Warning
      Code="FSH0005"
      Condition=" '@(_FrameShiftTestSurfaceManifest)' == '' "
      Text="FrameShift found no test-surface manifest for '$(MSBuildProjectName)', so every mutation point is reported as unreachable. Build the test project first and add its generated '*.frameshift' manifest to this project, or set 'FrameShiftSuppressSetupWarning' to 'true' to silence this warning. See https://github.com/dailydevops/frameshift for the documented setup."
    />

    <ItemGroup>
      <_FrameShiftTestSurfaceManifest Remove="@(_FrameShiftTestSurfaceManifest)" />
    </ItemGroup>
  </Target>

  <!--
    Reports whether the current project is itself a test project, by the very same rule
    'FrameShiftWarnOnMissingTestSurfaceManifest' uses to exempt one from FSH0005. Called on a
    referenced project through the MSBuild task by 'FrameShiftResolveManifestFileFromReference', so
    that target can tell a genuine production reference apart from a reference to another test
    project - for example a shared test-infrastructure project - which must not receive a manifest.
  -->
  <Target Name="FrameShiftReportIsTestProject" Returns="@(_FrameShiftIsTestProjectMarker)">
    <ItemGroup>
      <_FrameShiftIsTestProjectMarker
        Include="IsTestProject"
        Condition=" '$(IsTestProject)' == 'true' OR '$(IsTestableProject)' == 'true' OR '$(IsTestingPlatformApplication)' == 'true' OR '$(FrameShiftIsTestProject)' == 'true' "
      />
    </ItemGroup>
  </Target>

  <!--
    Every test project's ProjectReference to a project that actually contributes an assembly is a
    candidate to have the manifest written directly into the referenced project's directory, instead
    of next to the test project with an explicit AdditionalFiles entry pointing back to it - opt out
    of a specific reference with the metadata 'DisableFrameShift="true"'. The production project then
    picks the manifest up again through its own default '**/*.frameshift' glob in
    NetEvolve.FrameShift.props.

    A reference with 'ReferenceOutputAssembly="false"' or 'OutputItemType="Analyzer"' is excluded
    outright, unconditionally: such a reference exists for a build-time asset - most commonly the
    FrameShift analyzer project itself, referenced exactly that way by a test project working against
    a local checkout instead of the package - never for the production code under test, and its own
    directory is never a sensible manifest destination.

    A candidate that turns out to point at another test project - for instance a shared
    test-infrastructure project referenced by more than one test project - is dropped instead of
    honoured: such a project has no manifest of its own to receive, and misdirecting one into its
    directory would only confuse its own build. 'FrameShiftReportIsTestProject' answers that question
    on the referenced project itself; 'SkipNonexistentTargets' keeps a reference to a project that
    does not import these build assets at all from failing the build, treating it like any other
    production reference instead.

    Runs before 'FrameShiftConfigureTestSurfaceManifest', so the manifest location it resolves is
    already in place once that target reads '$(FrameShiftTestSurfaceManifestFile)'. Only fills in
    what the consuming project has not already decided for itself. A project with more than one
    surviving candidate - more than one production ProjectReference, none of them opted out - sets
    the property once per candidate and the last one silently wins; disable every reference except
    the one actually under test with 'DisableFrameShift="true"', or set
    '$(FrameShiftTestSurfaceManifestFile)' itself instead.
  -->
  <Target Name="FrameShiftResolveManifestFileFromReference" BeforeTargets="FrameShiftConfigureTestSurfaceManifest" Condition=" '$(FrameShiftEnabled)' == 'true' AND '$(DesignTimeBuild)' != 'true' ">
    <ItemGroup>
      <_FrameShiftManifestProjectReference
        Include="@(ProjectReference)"
        Condition="
          '%(ProjectReference.DisableFrameShift)' != 'true'
          AND '%(ProjectReference.ReferenceOutputAssembly)' != 'false'
          AND '%(ProjectReference.OutputItemType)' != 'Analyzer' "
      />
    </ItemGroup>

    <MSBuild
      Projects="@(_FrameShiftManifestProjectReference)"
      Targets="FrameShiftReportIsTestProject"
      Properties="Configuration=$(Configuration);Platform=$(Platform)"
      SkipNonexistentTargets="true"
      Condition=" '@(_FrameShiftManifestProjectReference)' != '' "
    >
      <Output TaskParameter="TargetOutputs" ItemName="_FrameShiftReferencedProjectIsTestProject" />
    </MSBuild>

    <PropertyGroup
      Condition=" '$(FrameShiftTestSurfaceManifestFile)' == ''
                                            AND '@(_FrameShiftManifestProjectReference)' != ''
                                            AND '@(_FrameShiftReferencedProjectIsTestProject)' == '' "
    >
      <FrameShiftTestSurfaceManifestFile>%(_FrameShiftManifestProjectReference.RootDir)%(_FrameShiftManifestProjectReference.Directory)$(MSBuildProjectName).$(TargetFramework).frameshift</FrameShiftTestSurfaceManifestFile>
    </PropertyGroup>

    <ItemGroup>
      <_FrameShiftManifestProjectReference Remove="@(_FrameShiftManifestProjectReference)" />
      <_FrameShiftReferencedProjectIsTestProject Remove="@(_FrameShiftReferencedProjectIsTestProject)" />
    </ItemGroup>
  </Target>

  <!--
    Decides whether this project writes a test-surface manifest, and prepares the build for it.

    The detection lives in a target and not in NetEvolve.FrameShift.props, because @(PackageReference) is
    not reliably populated when the package props are imported, and because item lists cannot be read
    from a property outside a target at all.
  -->
  <Target Name="FrameShiftConfigureTestSurfaceManifest" BeforeTargets="CoreCompile" Condition=" '$(FrameShiftEnabled)' == 'true' AND '$(DesignTimeBuild)' != 'true' ">
    <ItemGroup>
      <_FrameShiftTestFrameworkPackage
        Include="@(PackageReference)"
        Condition="
          $([MSBuild]::ValueOrDefault('%(Identity)', '').ToLowerInvariant().StartsWith('tunit'))
          Or $([MSBuild]::ValueOrDefault('%(Identity)', '').ToLowerInvariant().StartsWith('xunit'))
          Or $([MSBuild]::ValueOrDefault('%(Identity)', '').ToLowerInvariant().StartsWith('nunit'))
          Or $([MSBuild]::ValueOrDefault('%(Identity)', '').ToLowerInvariant().StartsWith('mstest')) "
      />
    </ItemGroup>

    <PropertyGroup>
      <!-- Only fill in what the consuming project has not decided for itself. -->
      <FrameShiftWriteTestSurfaceManifest Condition=" '$(FrameShiftWriteTestSurfaceManifest)' == '' AND '@(_FrameShiftTestFrameworkPackage)' != '' ">true</FrameShiftWriteTestSurfaceManifest>
      <FrameShiftWriteTestSurfaceManifest Condition=" '$(FrameShiftWriteTestSurfaceManifest)' == '' ">false</FrameShiftWriteTestSurfaceManifest>

      <!--
        A multi-targeting project runs one inner build per framework, and every one of them would write
        the very same file. Exactly one inner build is elected to do it: the one building the first
        entry of $(TargetFrameworks).
      -->
      <_FrameShiftPrimaryTargetFramework Condition=" '$(TargetFrameworks)' != '' ">$(TargetFrameworks.Split(';')[0].Trim())</_FrameShiftPrimaryTargetFramework>
      <_FrameShiftIsManifestWriter
        Condition=" '$(FrameShiftWriteTestSurfaceManifest)' == 'true'
                                              AND ( '$(TargetFrameworks)' == ''
                                                    OR '$(TargetFramework)' == '$(_FrameShiftPrimaryTargetFramework)' ) "
        >true</_FrameShiftIsManifestWriter>

      <!--
        The generator can only hand the manifest over as a generated source file, so that file has to be
        written to disk. $(CompilerGeneratedFilesOutputPath) is only defaulted by the SDK when
        $(EmitCompilerGeneratedFiles) was already true during evaluation, which it is not here.
      -->
      <EmitCompilerGeneratedFiles Condition=" '$(_FrameShiftIsManifestWriter)' == 'true' ">true</EmitCompilerGeneratedFiles>
      <CompilerGeneratedFilesOutputPath Condition=" '$(_FrameShiftIsManifestWriter)' == 'true' AND '$(CompilerGeneratedFilesOutputPath)' == '' "
        >$(IntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>

      <FrameShiftTestSurfaceManifestFile Condition=" '$(FrameShiftTestSurfaceManifestFile)' == '' "
        >$(MSBuildProjectDirectory)\$(MSBuildProjectName).$(TargetFramework).frameshift</FrameShiftTestSurfaceManifestFile>
    </PropertyGroup>

    <!--
      The SDK creates $(CompilerGeneratedFilesOutputPath) in its own 'CreateCompilerGeneratedFilesOutputPath'
      target, which also hooks BeforeTargets="CoreCompile" and is imported before this file, so it runs
      first - while $(EmitCompilerGeneratedFiles) is still false and its condition is therefore not met.
      The compiler does read the property late enough to honour it, but it does not create the directory
      and fails with CS0016. Creating the directory here is what closes that gap.
    -->
    <MakeDir Condition=" '$(_FrameShiftIsManifestWriter)' == 'true' " Directories="$(CompilerGeneratedFilesOutputPath)" />

    <!--
      The manifest is written into this project's own directory, so the default '**/*.frameshift'
      glob in NetEvolve.FrameShift.props picks it up again on the next build and hands the test project
      its own manifest. The production side would then judge the test assembly against a manifest that
      records members of the assemblies under test, find none of them declared here, and report FSH0001
      or a stale FSH0003 for every one of them.

      The exclusion cannot live in the props: the file name is only known once
      $(FrameShiftTestSurfaceManifestFile) has been resolved, and a value set in the consuming project is
      not visible yet when the package props are imported. Removing the item here is late enough for the
      property and still early enough for CoreCompile, which expands @(AdditionalFiles) when it runs.
    -->
    <ItemGroup Condition=" '$(FrameShiftWriteTestSurfaceManifest)' == 'true' ">
      <AdditionalFiles Remove="@(AdditionalFiles)" Condition=" '%(FullPath)' == '$([MSBuild]::NormalizePath($(FrameShiftTestSurfaceManifestFile)))' " />
    </ItemGroup>

    <ItemGroup>
      <_FrameShiftTestFrameworkPackage Remove="@(_FrameShiftTestFrameworkPackage)" />
    </ItemGroup>
  </Target>

  <!--
    Turns the generated file back into the manifest. The generated file is one single block comment
    whose first line is exactly '/*' and whose last line is exactly '*/'; everything in between is a
    verbatim manifest line, so dropping those two lines is all it takes.

    When the generated file is absent - no test framework was detected inside the compilation, or the
    generator did not run - $(_FrameShiftGeneratedManifestPath) stays empty, both tasks are skipped by
    their conditions and the existing manifest is left untouched.

    The target deliberately declares no Inputs and no Outputs. MSBuild's up-to-date check does not expand
    wildcards in Inputs; it treats '<path>\**\TestSurfaceManifest.g.cs' as a literal file name, finds no
    such file and therefore runs the target in full on every build anyway. Not writing when nothing
    changed is what actually keeps the build incremental, and that is WriteOnlyWhenDifferent's job below.
  -->
  <Target Name="FrameShiftWriteTestSurfaceManifest" AfterTargets="CoreCompile" Condition=" '$(_FrameShiftIsManifestWriter)' == 'true' AND '$(DesignTimeBuild)' != 'true' ">
    <ItemGroup>
      <_FrameShiftGeneratedManifest Include="$(CompilerGeneratedFilesOutputPath)\**\TestSurfaceManifest.g.cs" />
    </ItemGroup>

    <PropertyGroup>
      <_FrameShiftGeneratedManifestPath>%(_FrameShiftGeneratedManifest.FullPath)</_FrameShiftGeneratedManifestPath>
    </PropertyGroup>

    <ReadLinesFromFile File="$(_FrameShiftGeneratedManifestPath)" Condition=" '$(_FrameShiftGeneratedManifestPath)' != '' ">
      <Output TaskParameter="Lines" ItemName="_FrameShiftGeneratedManifestLine" />
    </ReadLinesFromFile>

    <ItemGroup>
      <_FrameShiftManifestLine Include="@(_FrameShiftGeneratedManifestLine)" Condition=" '%(Identity)' != '/*' AND '%(Identity)' != '*/' " />
    </ItemGroup>

    <!--
      No Encoding attribute on purpose. WriteLinesToFile defaults to UTF-8 without a byte order mark,
      which is what a checked-in text file should be. Asking for 'UTF-8' explicitly makes it write a BOM,
      and its WriteOnlyWhenDifferent comparison does not account for that BOM: the file then differs from
      itself and is rewritten on every single build. Because the manifest is an AdditionalFiles input of
      the projects under analysis, that new timestamp recompiles them every build as well, and their
      recompilation feeds the next one - the whole solution never reaches an up-to-date state again.
    -->
    <WriteLinesToFile File="$(FrameShiftTestSurfaceManifestFile)" Lines="@(_FrameShiftManifestLine)" Condition=" '@(_FrameShiftManifestLine)' != '' " Overwrite="true" WriteOnlyWhenDifferent="true" />

    <ItemGroup>
      <_FrameShiftGeneratedManifest Remove="@(_FrameShiftGeneratedManifest)" />
      <_FrameShiftGeneratedManifestLine Remove="@(_FrameShiftGeneratedManifestLine)" />
      <_FrameShiftManifestLine Remove="@(_FrameShiftManifestLine)" />
    </ItemGroup>
  </Target>
</Project>
