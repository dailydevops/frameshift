<Project>
  <!--
    NetEvolve.Frameshift - build assets.

    Intentionally minimal: the only job of this file is to tell the user when the analysis cannot do
    anything because no test-surface manifest reached the compiler.

    Set 'FrameshiftSuppressSetupWarning' to 'true' to silence FSHB0001, for example for projects that are
    deliberately not covered, or while the manifest of the first pass does not exist yet:

      <PropertyGroup>
        <FrameshiftSuppressSetupWarning>true</FrameshiftSuppressSetupWarning>
      </PropertyGroup>
  -->

  <Target
    Name="FrameshiftWarnOnMissingTestSurfaceManifest"
    BeforeTargets="CoreCompile"
    Condition=" '$(FrameshiftEnabled)' == 'true'
                      AND '$(FrameshiftSuppressSetupWarning)' != 'true'
                      AND '$(DesignTimeBuild)' != 'true'
                      AND '$(IsTestProject)' != 'true'
                      AND '$(IsTestingPlatformApplication)' != 'true'
                      AND '$(FrameshiftIsTestProject)' != 'true' "
  >
    <ItemGroup>
      <_FrameshiftTestSurfaceManifest Include="@(AdditionalFiles)" Condition=" '%(Extension)' == '.frameshift-tests' " />
    </ItemGroup>

    <Warning
      Code="FSHB0001"
      Condition=" '@(_FrameshiftTestSurfaceManifest)' == '' "
      Text="Frameshift found no test-surface manifest for '$(MSBuildProjectName)', so every mutation point is reported as unreachable. Build the TUnit test project first and add its generated '*.frameshift-tests' manifest to this project, or set 'FrameshiftSuppressSetupWarning' to 'true' to silence this warning. See https://github.com/dailydevops/frameshift for the documented setup."
    />

    <ItemGroup>
      <_FrameshiftTestSurfaceManifest Remove="@(_FrameshiftTestSurfaceManifest)" />
    </ItemGroup>
  </Target>
</Project>
