<Project>
  <!--
    NetEvolve.Frameshift - build assets.

    This file wires the Frameshift analyzers into the consuming project:
      * it discovers the test-surface manifests of the project and hands them to the compiler, and
      * it declares the configuration properties the analyzers are allowed to read.

    Configuration properties (set them in the consuming project, in a Directory.Build.props or on the
    command line via -p:Name=Value):

      FrameshiftEnabled                     true|false   Runs the analysis at all. Default: true.
      FrameshiftVerifyMutantCompilation     true|false   Compiles every mutant before it is reported.
                                                         Default: true.
      FrameshiftMaxMutantsPerMember         integer      Caps the mutants generated per member, at least 1.
                                                         Default: 64.
      FrameshiftReportTrivialMutants        true|false   Reports mutants without observable effect.
                                                         Default: true.
      FrameshiftSuppressSetupWarning        true|false   Silences the FSHB0001 setup warning emitted by
                                                         NetEvolve.Frameshift.targets. Default: false.
      FrameshiftEnableDefaultManifestItems  true|false   Adds every '**/*.frameshift-tests' file of the
                                                         project to @(AdditionalFiles). Default: true,
                                                         unless $(EnableDefaultItems) is false.
      FrameshiftWriteTestSurfaceManifest    true|false   Writes the generated test-surface manifest of a
                                                         test project next to the project file. The
                                                         default is decided in
                                                         NetEvolve.Frameshift.targets: true for a project
                                                         referencing a known test framework package
                                                         (TUnit, xunit, NUnit, MSTest), false otherwise.
                                                         Enabling it turns on $(EmitCompilerGeneratedFiles).
      FrameshiftTestSurfaceManifestFile     path         The manifest file that is written. Default:
                                                         $(MSBuildProjectDirectory)\$(MSBuildProjectName).frameshift-tests.
  -->

  <PropertyGroup Label="Frameshift defaults">
    <!-- Only fill in what the consuming project has not decided for itself. -->
    <FrameshiftEnabled Condition=" '$(FrameshiftEnabled)' == '' ">true</FrameshiftEnabled>
    <FrameshiftVerifyMutantCompilation Condition=" '$(FrameshiftVerifyMutantCompilation)' == '' ">true</FrameshiftVerifyMutantCompilation>
    <FrameshiftMaxMutantsPerMember Condition=" '$(FrameshiftMaxMutantsPerMember)' == '' ">64</FrameshiftMaxMutantsPerMember>
    <FrameshiftReportTrivialMutants Condition=" '$(FrameshiftReportTrivialMutants)' == '' ">true</FrameshiftReportTrivialMutants>
  </PropertyGroup>

  <PropertyGroup Label="Frameshift item defaults">
    <FrameshiftEnableDefaultManifestItems Condition=" '$(FrameshiftEnableDefaultManifestItems)' == '' AND '$(EnableDefaultItems)' == 'false' ">false</FrameshiftEnableDefaultManifestItems>
    <FrameshiftEnableDefaultManifestItems Condition=" '$(FrameshiftEnableDefaultManifestItems)' == '' ">true</FrameshiftEnableDefaultManifestItems>
  </PropertyGroup>

  <ItemGroup Label="Frameshift analyzer configuration">
    <!--
      Every property below is read in Configuration/FrameshiftOptionKeys.cs as
      'build_property.<Name>'. Keep both sides in sync.
    -->
    <CompilerVisibleProperty Include="FrameshiftEnabled" />
    <CompilerVisibleProperty Include="FrameshiftVerifyMutantCompilation" />
    <CompilerVisibleProperty Include="FrameshiftMaxMutantsPerMember" />
    <CompilerVisibleProperty Include="FrameshiftReportTrivialMutants" />
  </ItemGroup>

  <PropertyGroup Label="Frameshift manifest exclusions">
    <!--
      Output and intermediate directories are excluded, otherwise a manifest that was copied to the
      output would be picked up a second time. The custom directories are only appended when they are
      actually defined, because an empty value would expand to '**/*.frameshift-tests' and exclude
      everything.
    -->
    <_FrameshiftManifestExclude>$(MSBuildProjectDirectory)/bin/**/*.frameshift-tests;$(MSBuildProjectDirectory)/obj/**/*.frameshift-tests</_FrameshiftManifestExclude>
    <_FrameshiftManifestExclude Condition=" '$(BaseOutputPath)' != '' ">$(_FrameshiftManifestExclude);$(BaseOutputPath)**/*.frameshift-tests</_FrameshiftManifestExclude>
    <_FrameshiftManifestExclude Condition=" '$(BaseIntermediateOutputPath)' != '' ">$(_FrameshiftManifestExclude);$(BaseIntermediateOutputPath)**/*.frameshift-tests</_FrameshiftManifestExclude>
  </PropertyGroup>

  <ItemGroup Label="Frameshift test-surface manifests" Condition=" '$(FrameshiftEnableDefaultManifestItems)' == 'true' ">
    <!--
      The production side of the analysis reads the manifest as an AdditionalText, so the manifests have
      to reach the compiler.
    -->
    <AdditionalFiles Include="$(MSBuildProjectDirectory)/**/*.frameshift-tests" Exclude="$(_FrameshiftManifestExclude)" />
  </ItemGroup>
</Project>
