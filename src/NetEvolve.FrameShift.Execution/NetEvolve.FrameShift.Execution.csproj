<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      net10.0 only, deliberately narrower than $(_NetTargetFrameworks): execution-based mutation
      verification needs a collectible, unloadable AssemblyLoadContext, which every net6.0+ runtime
      already has, but this tool otherwise has no consumer yet and no compatibility promise to keep, so
      it tracks the newest supported runtime instead of the widest one. Broadening the matrix is only a
      TargetFrameworks edit away once there is a reason to.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <!--
      This is an internal engineering tool for execution-based mutation verification, not (yet) a
      published package: there is no CLI or MSBuild integration wired up for it yet, see the remarks of
      MutationExecutionEngine. Packing is switched off until that story exists.
    -->
    <IsPackable>false</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NetEvolve.FrameShift\NetEvolve.FrameShift.csproj" />
  </ItemGroup>
  <ItemGroup Label="Test visibility">
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>NetEvolve.FrameShift.Tests.Execution</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
